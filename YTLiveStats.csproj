<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>YTLiveStats</RootNamespace>
    <AssemblyName>YTLiveStats</AssemblyName>
    <AssemblyTitle>YTLiveStats</AssemblyTitle>
    <Product>YTLiveStats</Product>
    <Company>YTLiveStats</Company>
    <Version>1.0.0</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="YTLiveStats.app.ico" />
  </ItemGroup>

</Project>
